# Copy to .env (never commit .env). On Vercel/Render set these in the dashboard.

PORT=5000
NODE_ENV=development

# --- MongoDB Atlas (REQUIRED). Atlas -> Connect -> Drivers -> copy the SRV string.
# Also add your host's IP (or 0.0.0.0/0 for Vercel) under Atlas -> Network Access.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/omas?retryWrites=true&w=majority

# --- Auth (REQUIRED in production). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend origin(s) allowed to call this API with cookies, comma separated
CLIENT_ORIGINS=http://localhost:5173
# Cross-site cookies need SameSite=None (default in production). Use "lax" if the frontend proxies /api on the same domain.
# COOKIE_SAMESITE=none

# --- First super admin (created only if no super admin exists yet)
ADMIN_EMAIL=admin@omas.com
ADMIN_PASSWORD=

# --- Optional: email (order notifications to the owner + password reset links)
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=moiiizyyy@gmail.com

RESTAURANT_TIMEZONE=Asia/Karachi
