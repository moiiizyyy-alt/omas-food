{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "my-backend": {
      "path": "oma's backend",
      "framework": "express"
    },
    "vite-project": {
      "path": "oma's fastfood/vite-project",
      "framework": "vite"
    }
  },
  "routes": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "my-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "vite-project"
      }
    }
  ]
}
