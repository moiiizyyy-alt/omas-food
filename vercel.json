{
  "buildCommand": "npm --prefix \"oma's fastfood/vite-project\" run build",
  "outputDirectory": "oma's fastfood/vite-project/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
